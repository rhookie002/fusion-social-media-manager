# Create .gitignore file
cat > .gitignore << 'EOF'
# Environment variables (CRITICAL - never commit!)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Build files
dist/
build/
.next/
out/

# Logs
*.log
logs/

# Railway deployment
railway/
.railway/

# Supabase
supabase/.temp/

# Backup files
*.bak
*.backup
EOF